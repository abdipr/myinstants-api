{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/(best|detail|favorites|recent|search|trending|uploaded)$", "dest": "/api/$1.php" },
    { "src": "^/(.*)$", "dest": "/api/404.php" }
  ]
}
